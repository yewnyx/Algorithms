<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Yewnyx.Algorithms.Visualizer.Views"
             x:Class="Yewnyx.Algorithms.Visualizer.Views.GridPanel">
    <UserControl.Styles>
        <Style Selector="ToggleButton.mode">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#181B21" Padding="10,8" BorderBrush="#262B33" BorderThickness="0,0,0,1">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton x:Name="ModeDistance" Classes="mode" Content="Distance" IsChecked="True" />
                    <ToggleButton x:Name="ModeRegions" Classes="mode" Content="Regions" />
                    <ToggleButton x:Name="ModeTravel" Classes="mode" Content="Travel" />
                    <ToggleButton x:Name="ModeRoutes" Classes="mode" Content="Routes" />
                </StackPanel>
                <TextBlock x:Name="CaptionText" Foreground="#C8D0DC" FontSize="13" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <StackPanel x:Name="BodyPanel" Orientation="Horizontal" Spacing="8" Margin="0,0,24,0">
                        <TextBlock Text="Body radius" Foreground="#C8D0DC" VerticalAlignment="Center"
                                   ToolTip.Tip="The radius of the body that has to fit: a cell is open when its centre is at least this far from every shape." />
                        <Slider x:Name="RadiusSlider" Minimum="0.3" Maximum="0.9" Value="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="220" VerticalAlignment="Center" />
                        <TextBlock x:Name="RadiusText" Foreground="#E8EDF4" Width="64" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="CostPanel" Orientation="Horizontal" Spacing="8" Margin="0,0,24,0">
                        <Button x:Name="WallButton" Content="Wall off here" ToolTip.Tip="Closes a 3 m cube about the probe: nothing can go through it." />
                        <Button x:Name="SlowButton" Content="Slow zone here" ToolTip.Tip="Makes a 3 m cube about the probe dearer to cross, so the field and the route go round it when they can." />
                        <Button x:Name="ClearButton" Content="Clear" ToolTip.Tip="Takes every wall and slow zone away." />
                    </StackPanel>
                    <CheckBox x:Name="ShapesBox" Content="Use the shapes" IsChecked="True" VerticalAlignment="Center" Foreground="#C8D0DC"
                              ToolTip.Tip="On: the library may prove a leg clear against the shapes themselves. Off: it is given no shapes and proves a leg by the map alone, which needs more room than the radius, so legs only the shapes accept are lost." />
                </WrapPanel>
                <Expander x:Name="ExpertBox" Header="Expert settings and notes" IsExpanded="False" Padding="0,6,0,0" FontSize="12" Foreground="#7F8896">
                    <StackPanel Spacing="6">
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="SHAPES" Width="56" />
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Seed" ToolTip.Tip="Which boxes, spheres and capsules." /><NumericUpDown x:Name="SeedBox" Minimum="0" Maximum="2147483647" Increment="1" Value="1" FormatString="0" Width="64" /></StackPanel>
                            <Button x:Name="NewButton" Content="New shapes" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <CheckBox x:Name="SolidsBox" Content="Show the solids" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#C8D0DC"
                                      ToolTip.Tip="The pale shapes are the solids as the exact test sees them. The cell colours are only what the grid stored." />
                            <Button x:Name="ResetViewButton" Content="Reset 3D view" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Back to the isometric angle. Drag the 3D view to orbit and use the wheel over it to zoom." />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="GRID" Width="56" />
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Unit (m)" ToolTip.Tip="What one count of wall distance is worth. A cell's distance is stored rounded down to a whole number of these." /><NumericUpDown x:Name="UnitBox" Minimum="0.03125" Maximum="0.5" Increment="0.03125" Value="0.125" FormatString="0.#####" Width="90" /></StackPanel>
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Cap (counts)" ToolTip.Tip="The largest count stored: a cell this far or more from every shape holds it, and no more is said about it." /><NumericUpDown x:Name="CapBox" Minimum="1" Maximum="255" Increment="1" Value="8" FormatString="0" Width="64" /></StackPanel>
                            <TextBlock Classes="section" Text="PROBE" Width="56" Margin="16,0,0,0" />
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="x (m)" /><NumericUpDown x:Name="XBox" Minimum="0" Maximum="32" Increment="0.25" Value="16" FormatString="0.00" Width="80" /></StackPanel>
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="y (m)" ToolTip.Tip="Where the side slice cuts. The wheel over the side slice moves it." /><NumericUpDown x:Name="YBox" Minimum="0" Maximum="20" Increment="0.25" Value="10" FormatString="0.00" Width="80" /></StackPanel>
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="z (m)" ToolTip.Tip="Where the top-down slice cuts. The wheel over the top-down slice moves it." /><NumericUpDown x:Name="ZBox" Minimum="0" Maximum="12" Increment="0.25" Value="2" FormatString="0.00" Width="80" /></StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="REGIONS" Width="56" />
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Seeds" ToolTip.Tip="The yellow boxes the flood starts from, placed where there is room. A cell no seed reaches belongs to no region, open or not." /><NumericUpDown x:Name="SeedCountBox" Minimum="0" Maximum="8" Increment="1" Value="3" FormatString="0" Width="56" /></StackPanel>
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Reach (m)" ToolTip.Tip="How far the nearest-open query looks from the probe." /><NumericUpDown x:Name="ReachBox" Minimum="0" Maximum="20" Increment="0.5" Value="3" FormatString="0.0" Width="76" /></StackPanel>
                            <CheckBox x:Name="LikeBox" Content="Nearest in the anchor's region" IsChecked="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#C8D0DC"
                                      ToolTip.Tip="Hold the nearest-open query to the region of the cell holding the pink diamond, the anchor: the nearest place that can be reached from there. Shift or the right button puts the anchor." />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="TRAVEL" Width="56" />
                            <StackPanel Classes="field">
                                <TextBlock Classes="label" Text="Goal" ToolTip.Tip="Where the field starts: a point (the pink diamond, which Shift or the right button moves), or the plane through a door, so the field leads out through it." />
                                <ComboBox x:Name="GoalBox" SelectedIndex="0" VerticalAlignment="Center" Width="190">
                                    <ComboBoxItem Content="The anchor (a point)" />
                                    <ComboBoxItem Content="First door (a plane)" />
                                    <ComboBoxItem Content="Second door (a plane)" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Classes="field"><TextBlock Classes="label" Text="Slow cost" ToolTip.Tip="What a slow zone costs to cross: 0 is normal and each 16 adds one more crossing's worth." /><NumericUpDown x:Name="CostBox" Minimum="1" Maximum="254" Increment="16" Value="64" FormatString="0" Width="70" /></StackPanel>
                            <CheckBox x:Name="StrokesBox" Content="Strokes downhill" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#C8D0DC"
                                      ToolTip.Tip="A short stroke on every other cell: the direction the field leads down from there, as far as it lies in the slice." />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Classes="section" Text="ROUTE" Width="56" />
                            <CheckBox x:Name="CellsBox" Content="Show the cells' way" IsChecked="True" VerticalAlignment="Center" Foreground="#C8D0DC"
                                      ToolTip.Tip="The way the search found, from cell centre to cell centre, before it is pulled straight." />
                            <CheckBox x:Name="StraightBox" Content="Show it pulled straight" IsChecked="True" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#C8D0DC"
                                      ToolTip.Tip="The same way with every stretch that a straight leg can replace replaced by one." />
                        </WrapPanel>
                        <TextBlock x:Name="HintText" Foreground="#7F8896" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#14171D" Padding="12,8" MinHeight="72" BorderBrush="#262B33" BorderThickness="0,0,0,1">
            <UniformGrid x:Name="TableGrid" Columns="3" />
        </Border>

        <Grid ColumnDefinitions="1.35*,2,*,2,*">
            <views:WallView3D x:Name="CubeView" Grid.Column="0" />
            <views:WallSliceView x:Name="TopView" Grid.Column="2" />
            <views:WallSliceView x:Name="SideView" Grid.Column="4" />
        </Grid>
    </DockPanel>
</UserControl>
